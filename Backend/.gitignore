# =====================================================
# BUILD AND DEPENDENCIES
# =====================================================
# Maven
target/
.m2/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Build output
out/
bin/
build/
dist/
*.class

# =====================================================
# IDE AND EDITOR
# =====================================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# VS Code
.vscode/
*.code-workspace

# NetBeans
nbproject/
.nb-gradle/
.gradle/

# Eclipse
.classpath
.project
.settings/
.factorypath

# Sublime
*.sublime-workspace
*.sublime-project

# Editor backups
*~
*.swp
*.swo
*.swn

# =====================================================
# ENVIRONMENT AND CONFIGURATION
# =====================================================
# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.production.local

# Application configuration
# CRITICAL: Never commit application.properties with secrets!
# Use application.properties.example instead
application.properties
application-local.properties
application-dev.properties
application-prod.properties
application-test.properties
application-*.properties
!application.properties.example

# =====================================================
# UPLOADS AND USER FILES
# =====================================================
# User uploaded files should not be tracked
# These are managed separately in production
uploads/
uploads/**/*
!uploads/.gitkeep

# Temporary files
tmp/
temp/
*.tmp
.tmp/

# =====================================================
# DEPLOYMENT CONFIGURATION
# =====================================================
# Deployment files - manage these separately or via environment
# CRITICAL: These files contain production configs and should NOT be tracked
Procfile
render.yaml
railway.yaml
deploy.yaml
docker-compose.yml
docker-compose.*.yml
Dockerfile
docker/
.dockerignore

# CI/CD workflows and automation
.github/
.gitlab-ci.yml
.circleci/
.travis.yml
azure-pipelines.yml

# =====================================================
# LOGS AND DEBUG
# =====================================================
*.log
logs/
*.out
*.err

# =====================================================
# DATABASE
# =====================================================
# Local database files
*.db
*.sqlite
*.sqlite3
*.h2.db

# =====================================================
# OS FILES
# =====================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Desktop.ini
.Thumbs.db

# Linux
.directory

# =====================================================
# MISC
# =====================================================
# Maven wrapper (optional - usually tracked)
# Uncomment if you want to ignore these:
# mvnw
# mvnw.cmd
# .mvn/

# IDE plugins cache
.plugins/

# Java class files
*.class

# Package Files
*.jar.original
